#!/bin/bash
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
OUT="$ROOT/.build/mac-app"
APP="$OUT/DerivedData/Build/Products/Debug/muse-man.app"
LOG="$OUT/app.log"
HELPER="$OUT/helper"
SHOTS="${TMPDIR:-/tmp}"; SHOTS="${SHOTS%/}/muse-man-screenshots/$(git -C "$ROOT" branch --show-current 2>/dev/null || true)"
SOURCE="$ROOT/scripts/mac-app-helper.swift"

export MAC_APP_WINDOW=""
if [[ "${1:-}" == "--window" ]]; then
    MAC_APP_WINDOW="${2:-}"
    shift 2
fi

usage() {
    cat <<EOF
usage: scripts/mac-app [--window <n|title>] <command>
  --window <n|title>  act on window n from \`windows\` (oldest first), or the one with this title,
                    instead of the largest window
  build             build the macOS app
  launch [--scratch | --scratch-empty]
                    quit any copy this script started, launch fresh in the background,
                    log stdout/stderr; --scratch opens a seeded in-memory store instead of the real one,
                    --scratch-empty an empty one
  quit              quit the app this script launched
  screenshot [name] capture the window to $SHOTS/<name>.png
                    (outside the repo, so it survives worktree cleanup; default name is a timestamp)
  elements          print the window's accessibility tree: role, "label", = value
  press <label> [n] press the button, row or menu-bar item with this label, in the background
  fill <label> <text> [n]
                    replace the text of the field with this label or placeholder, in the background
  pick <label> <item> [n]
                    choose item from the pop-up button with this label, in the background
                    (a label matches exactly, else as a case-insensitive substring;
                    n picks one when several match)
  click <x> <y>     click at pixel x,y of the screenshot PNG (full-size pixels)
  drag <x1> <y1> <x2> <y2>
                    press at x1,y1, hold, move to x2,y2 and release (screenshot pixels)
  resize <w> <h>    resize the window to w×h points (half the screenshot pixels)
  windows           list the app's windows, oldest first: number, title, size in points
  type <text>       type text into the focused field
  choose-file <path>
                    pick this file in the open file panel (Go to Folder, then Open)
  log               print the app's stdout/stderr since launch
EOF
    exit 1
}

pid() {
    pgrep -f "$APP/Contents/MacOS/muse-man" | head -1 || true
}

helper() {
    if [[ ! -x "$HELPER" || "$SOURCE" -nt "$HELPER" ]]; then
        mkdir -p "$OUT"
        swiftc -O -o "$HELPER" "$SOURCE"
    fi
    "$HELPER" "$@"
}

focus() {
    local p
    p=$(pid)
    helper front "$p" && return 0
    for _ in 1 2 3; do
        osascript -e "tell application \"System Events\" to set frontmost of (first process whose unix id is $p) to true"
        sleep 0.3
        helper front "$p" && return 0
    done
    echo "another app keeps taking focus; is another agent driving its own copy?" >&2
    exit 1
}

unlocked() {
    if helper locked; then
        echo "screen locked: ask the user to unlock the Mac" >&2
        exit 1
    fi
}

running_pid() {
    local p
    p=$(pid)
    [[ -n "$p" ]] || { echo "app not running: scripts/mac-app launch" >&2; exit 1; }
    echo "$p"
}

case "${1:-}" in
build)
    mkdir -p "$OUT"
    xcodebuild -project "$ROOT/muse-man.xcodeproj" -scheme muse-man -destination 'platform=macOS' \
        -derivedDataPath "$OUT/DerivedData" build | xcbeautify --quiet
    ;;
launch)
    unlocked
    pkill -f "$APP/Contents/MacOS/muse-man" || true
    : >"$LOG"
    args=()
    [[ "${2:-}" == "--scratch" ]] && args=(--args -scratchStore)
    [[ "${2:-}" == "--scratch-empty" ]] && args=(--args -scratchStore -emptyStore)
    open -g -n --stdout "$LOG" --stderr "$LOG" "$APP" ${args[@]+"${args[@]}"}
    for _ in $(seq 20); do
        p=$(pid)
        if [[ -n "$p" ]] && helper window "$p" >/dev/null 2>&1; then
            echo "launched pid $p, log at $LOG"
            exit 0
        fi
        sleep 0.5
    done
    echo "no window after 10s" >&2
    exit 1
    ;;
quit)
    pkill -f "$APP/Contents/MacOS/muse-man" || true
    ;;
screenshot)
    unlocked
    mkdir -p "$SHOTS"
    file="$SHOTS/${2:-$(date +%H%M%S)}"
    [[ "$file" == *.png ]] || file="$file.png"
    screencapture -o -x -l "$(helper window "$(running_pid)")" "$file"
    echo "$file"
    ;;
click)
    [[ $# -eq 3 ]] || usage
    p=$(running_pid)
    unlocked
    focus
    helper click "$p" "$2" "$3"
    ;;
drag)
    [[ $# -eq 5 ]] || usage
    p=$(running_pid)
    unlocked
    focus
    helper drag "$p" "$2" "$3" "$4" "$5"
    ;;
resize)
    [[ $# -eq 3 ]] || usage
    helper resize "$(running_pid)" "$2" "$3" || { echo "resize failed: is Accessibility allowed for this terminal?" >&2; exit 1; }
    ;;
windows)
    helper windows "$(running_pid)"
    ;;
elements)
    helper elements "$(running_pid)"
    ;;
press)
    [[ $# -ge 2 ]] || usage
    helper press "$(running_pid)" "${@:2}"
    ;;
fill | pick)
    [[ $# -ge 3 ]] || usage
    helper "$1" "$(running_pid)" "${@:2}"
    ;;
type)
    [[ $# -eq 2 ]] || usage
    running_pid >/dev/null
    unlocked
    focus
    osascript -e "tell application \"System Events\" to keystroke \"${2//\"/\\\"}\""
    ;;
choose-file)
    [[ $# -eq 2 && -e "$2" ]] || usage
    file="$(cd "$(dirname "$2")" && pwd)/$(basename "$2")"
    running_pid >/dev/null
    unlocked
    focus
    osascript - "$file" <<'EOF'
on run argv
    tell application "System Events"
        keystroke "g" using {command down, shift down}
        delay 0.8
        keystroke item 1 of argv
        delay 0.5
        key code 36
        delay 0.8
        key code 36
    end tell
end run
EOF
    ;;
log)
    cat "$LOG"
    ;;
*)
    usage
    ;;
esac
